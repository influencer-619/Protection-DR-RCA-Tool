<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Protection Disturbance Analysis Report — {{ (analysis.event or {}).event_id or "Event" }}</title>
  <style>
    :root {
      --ink: #1e2a32;
      --muted: #5a6b7a;
      --line: #d5dee6;
      --panel: #f4f7fa;
      --accent: #1f6f8b;
      --ok: #0b7a45;
      --warn: #9a6b00;
      --bad: #a12828;
    }
    body {
      font-family: "Segoe UI", Calibri, Arial, sans-serif;
      margin: 0;
      padding: 28px 32px 40px;
      color: var(--ink);
      line-height: 1.5;
      background: #fff;
    }
    .cover {
      border: 1px solid var(--line);
      border-left: 5px solid var(--accent);
      background: linear-gradient(180deg, #f7fafc 0%, #fff 100%);
      padding: 18px 20px;
      margin-bottom: 22px;
    }
    .cover h1 {
      margin: 0 0 6px;
      font-size: 1.45rem;
      color: var(--accent);
      border: 0;
      padding: 0;
    }
    .cover .sub { color: var(--muted); font-size: 0.92rem; margin: 0 0 10px; }
    .kpis {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-top: 12px;
    }
    .kpi {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 8px 10px;
      min-width: 0;
      overflow: hidden;
    }
    .kpi .lbl {
      display: block;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
      margin-bottom: 2px;
    }
    .kpi .val {
      display: block;
      font-weight: 700;
      font-size: 0.88rem;
      line-height: 1.3;
      overflow-wrap: anywhere;
      word-break: break-word;
      white-space: normal;
    }
    @media (max-width: 720px) {
      .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    h2 {
      font-size: 1.05rem;
      margin: 26px 0 10px;
      padding-bottom: 5px;
      border-bottom: 2px solid var(--accent);
      color: #234457;
    }
    h3 {
      font-size: 0.9rem;
      margin: 14px 0 6px;
      color: #345468;
    }
    p { margin: 0 0 8px; }
    .meta { color: var(--muted); font-size: 0.85rem; }
    table {
      border-collapse: collapse;
      width: 100%;
      margin: 6px 0 14px;
      border: 1px solid var(--line);
    }
    th, td {
      border: 1px solid var(--line);
      padding: 7px 9px;
      text-align: left;
      font-size: 0.86rem;
      vertical-align: top;
    }
    th {
      background: var(--panel);
      color: #234457;
      font-weight: 700;
    }
    .kv { width: 100%; }
    .kv th { width: 32%; font-weight: 600; }
    ul { margin: 0 0 10px; padding-left: 20px; }
    .kind { font-weight: 700; font-size: 0.72rem; letter-spacing: 0.04em; }
    .OBSERVED { color: var(--ok); }
    .CALCULATED { color: #0663b8; }
    .INFERRED { color: var(--warn); }
    .HYPOTHESIS { color: #7a2d8a; }
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      border: 1px solid var(--line);
      background: var(--panel);
    }
    .badge-ok { color: var(--ok); background: #e8f7ef; border-color: #b9e2cb; }
    .badge-warn { color: var(--warn); background: #fff6df; border-color: #f0d48a; }
    .badge-bad { color: var(--bad); background: #fdecec; border-color: #f0b4b4; }
    .callout {
      background: #eef7fb;
      border: 1px solid #c7e0ea;
      border-left: 4px solid var(--accent);
      padding: 10px 12px;
      margin: 8px 0 14px;
      border-radius: 4px;
    }
    .limitations {
      background: #fff8e6;
      border-left: 4px solid #d39b1f;
      padding: 10px 12px;
      border-radius: 4px;
    }
    .footnote {
      margin-top: 28px;
      padding-top: 10px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 0.78rem;
    }
    @media print {
      body { padding: 12px; }
      .cover { break-inside: avoid; }
      h2 { break-after: avoid; }
    }
  </style>
</head>
<body>
{% set ev = analysis.event or {} %}
{% set decision = analysis.decision or {} %}
{% set fault = analysis.fault_classification or {} %}
{% set rca = analysis.rca_hypotheses or {} %}
{% set primary = rca.primary or {} %}
{% set dq = analysis.data_quality or {} %}
{% set ct = (dq.comtrade or [None])[0] %}
{% set settings = analysis.setting_reference or {} %}
{% set timing = analysis.timing or {} %}
{% set breaker = analysis.breaker_analysis or {} %}
{% set elec = analysis.electrical_analysis or {} %}

{% set casc = analysis.cascade or {} %}
{% set mend = analysis.multi_end or {} %}
{% set comb = analysis.combined_analysis or casc.combined or mend.combined or {} %}
{% set is_cascade = casc.detected or (comb.mode and ('CASCADE' in (comb.mode|string|upper) or 'LBB' in (comb.mode|string|upper))) %}
{% set is_line = mend.detected or (comb.mode and ('LINE' in (comb.mode|string|upper) or 'MULTI_END' in (comb.mode|string|upper))) %}
{% set _ev_evc = fault.evidence.event_classification if fault.evidence is mapping and fault.evidence.event_classification is mapping else {} %}
{% set event_class = fault.event_class or _ev_evc.event_class or (fault.evidence.event_class if fault.evidence is mapping else none) or "UNKNOWN" %}
{% set key_seq = analysis.key_sequence or [] %}
{% set intertrip_summary = analysis.intertrip_summary or "None asserted" %}

{# ——— Cover ——— #}
<div class="cover">
  <h1>
    {% if is_cascade %}Cascade / LBB Disturbance Analysis Report
    {% elif is_line %}Local / Remote Multi-End Analysis Report
    {% else %}Protection Disturbance Analysis Report{% endif %}
  </h1>
  <p class="sub">
    {% if is_cascade %}Combined initiator + backup · breaker failure primary RCA
    {% elif is_line %}Combined LOCAL + REMOTE packages · single line disturbance
    {% else %}Deterministic engineering report · COMTRADE / DR analysis{% endif %}
  </p>
  <table class="kv">
    <tr><th>Event</th><td><strong>{{ ev.event_id or "NOT AVAILABLE" }}</strong></td></tr>
    <tr><th>DR time (relay)</th><td>{{ ev.event_datetime or "NOT AVAILABLE" }}</td></tr>
    <tr><th>Created in app</th><td>{{ ev.created_at or "—" }}</td></tr>
    <tr>
      <th>Location</th>
      <td>
        {% if ev.substation or ev.bay or ev.feeder %}
          {{ ev.substation or "—" }}{% if ev.bay %} · {{ ev.bay }}{% endif %}{% if ev.feeder %} · {{ ev.feeder }}{% endif %}
        {% else %}
          NOT AVAILABLE
        {% endif %}
      </td>
    </tr>
    <tr><th>Relay / IED</th><td>{{ ev.relay_tag or ev.recording_device or "NOT AVAILABLE" }}</td></tr>
    <tr>
      <th>System</th>
      <td>
        {% if ev.nominal_voltage_kv %}{{ ev.nominal_voltage_kv }} kV{% else %}—{% endif %}
        {% if ev.nominal_frequency_hz or elec.nominal_frequency_hz %}
          · {{ ev.nominal_frequency_hz or elec.nominal_frequency_hz }} Hz
        {% endif %}
      </td>
    </tr>
  </table>
  <div class="kpis">
    <div class="kpi">
      <span class="lbl">Event class</span>
      <span class="val">{{ event_class | humanize_label }}</span>
    </div>
    <div class="kpi">
      <span class="lbl">Fault type</span>
      <span class="val">{{ (fault.fault_type or "UNKNOWN") | humanize_label }}</span>
    </div>
    <div class="kpi">
      <span class="lbl">Primary RCA</span>
      <span class="val">{{ (primary.title or primary.hypothesis_id or "INCONCLUSIVE") | humanize_label }}</span>
    </div>
    <div class="kpi">
      <span class="lbl">Decision</span>
      <span class="val">{{ (decision.state or ev.decision_state or "—") | humanize_label }}</span>
    </div>
  </div>
</div>

{# ——— 1. Executive summary ——— #}
<h2>1. Executive Summary</h2>
<div class="callout">
  <p>
    <strong>{{ primary.title or "Root cause not confirmed" }}</strong>
    {% if primary.status %}
      — <span class="badge {% if primary.status == 'CONFIRMED' %}badge-ok{% elif primary.status in ['PROBABLE','POSSIBLE'] %}badge-warn{% else %}badge-bad{% endif %}">{{ primary.status }}</span>
      {% if primary.score %} (score {{ primary.score }}){% endif %}
    {% endif %}
  </p>
  {% if primary.statement %}
  <p>{{ primary.statement }}</p>
  {% endif %}
  <p class="meta">
    Event class: <strong>{{ event_class | humanize_label }}</strong>
    · Fault: <strong>{{ fault.fault_type or "UNKNOWN" }}</strong>
    ({{ fault.status or "—" }}, {{ fault.confidence or "INCONCLUSIVE" }})
    {% if intertrip_summary and intertrip_summary != "None asserted" %}
      · Intertrip: <strong>{{ intertrip_summary }}</strong>
    {% endif %}
    {% if analysis.operated_elements %}
      · Operated elements: <strong>{% for el in analysis.operated_elements %}{{ el | ansi_label }}{% if not loop.last %}, {% endif %}{% endfor %}</strong>
    {% endif %}
    {% if timing.pickup_to_trip_ms is defined and timing.pickup_to_trip_ms is not none %}
      · Pickup→trip: <strong>{{ timing.pickup_to_trip_ms }} ms</strong>
    {% endif %}
    {% if timing.trip_to_clear_ms is defined and timing.trip_to_clear_ms is not none %}
      · Trip→clear: <strong>{{ timing.trip_to_clear_ms }} ms</strong>
    {% endif %}
    {% if fault.distance_display and "NOT_APPLICABLE" not in (fault.distance_display|string|upper) and "NOT APPLICABLE" not in (fault.distance_display|string|upper) %}
      · Location: <strong>{{ fault.distance_display }}</strong>
    {% endif %}
  </p>
  {% if primary.causal_chain %}
  <p class="meta"><strong>Causal chain:</strong>
    {% for step in primary.causal_chain[:8] %}{{ step }}{% if not loop.last %} → {% endif %}{% endfor %}
  </p>
  {% endif %}
</div>
<ul>
{% for s in statements %}
  <li><span class="kind {{ s.kind }}">[{{ s.kind }}]</span> {{ s.text }}</li>
{% else %}
  <li>No structured statements — see detailed sections below.</li>
{% endfor %}
</ul>

{% if is_cascade %}
<h2>Cascade / LBB Analysis</h2>
<div class="callout" style="background:#fff4ed;border-color:#f0c2a0;border-left-color:#c2410c;">
  <p><strong>Combined cascade / LBB — single incident</strong></p>
  <p>
    Initiator bay breaker failure with upstream / backup clearance.
    Primary RCA is breaker failure; backup trip is the cascade consequence, not a second unrelated fault.
  </p>
  <table class="kv">
    <tr><th>Initiator</th><td>{{ casc.initiator_label or comb.primary_role or "—" }}
      {% if comb.primary_event_code %} ({{ comb.primary_event_code }}){% endif %}</td></tr>
    <tr><th>Backup</th><td>{{ casc.backup_label or comb.peer_role or "—" }}
      {% if comb.peer_event_code %} ({{ comb.peer_event_code }}){% endif %}</td></tr>
    <tr><th>Roles</th><td>{{ comb.primary_role or "INITIATOR" }} → {{ comb.peer_role or "BACKUP" }}</td></tr>
    {% if casc.notes %}<tr><th>Notes</th><td>{{ casc.notes }}</td></tr>{% endif %}
    {% if casc.time_order %}
    <tr><th>Time order</th><td>
      {% if casc.time_order.order_ok == true %}Initiator → intertrip → backup OK
      {% elif casc.time_order.order_ok == false %}Check — order inconsistent
      {% else %}Not assessed{% endif %}
      {% if casc.time_order.notes %} ({{ casc.time_order.notes }}){% endif %}
    </td></tr>
    {% endif %}
  </table>
</div>
{% elif is_line %}
<h2>Local / Remote Multi-End Analysis</h2>
<div class="callout" style="background:#eef7fb;border-color:#c7e0ea;">
  <p><strong>Line multi-end — single disturbance</strong></p>
  <p>LOCAL + REMOTE packages for the same line fault (differential / two-ended view).</p>
  <table class="kv">
    <tr><th>Local</th><td>{{ mend.local_label or "LOCAL" }}
      {% if mend.local_event_code %} ({{ mend.local_event_code }}){% endif %}</td></tr>
    <tr><th>Remote</th><td>{{ mend.remote_label or "REMOTE" }}
      {% if mend.remote_event_code %} ({{ mend.remote_event_code }}){% endif %}</td></tr>
    {% if mend.notes %}<tr><th>Notes</th><td>{{ mend.notes }}</td></tr>{% endif %}
  </table>
</div>
{% endif %}

{# ——— 2. Event identification ——— #}
<h2>2. Event Identification</h2>
<table class="kv">
  <tr><th>Event ID</th><td>{{ ev.event_id or "—" }}</td></tr>
  <tr><th>DR time (relay)</th><td>{{ ev.event_datetime or "—" }}</td></tr>
  <tr><th>Created in app</th><td>{{ ev.created_at or "—" }}</td></tr>
  <tr><th>Description</th><td>{{ ev.description or "—" }}</td></tr>
  <tr><th>Substation</th><td>{{ ev.substation or ev.station_name or "—" }}</td></tr>
  <tr><th>Bay</th><td>{{ ev.bay or "—" }}</td></tr>
  <tr><th>Feeder / circuit</th><td>{{ ev.feeder or "—" }}</td></tr>
  <tr><th>Nominal voltage</th><td>{% if ev.nominal_voltage_kv %}{{ ev.nominal_voltage_kv }} kV{% else %}—{% endif %}</td></tr>
  <tr><th>Relay / IED tag</th><td>{{ ev.relay_tag or "—" }}</td></tr>
  <tr><th>Recording device</th><td>{{ ev.recording_device or "—" }}</td></tr>
  <tr><th>Event status</th><td>{{ ev.status or "—" }}</td></tr>
</table>

{# ——— 3. Record quality ——— #}
<h2>3. COMTRADE Record Quality</h2>
{% if ct %}
<table class="kv">
  <tr><th>Station (CFG)</th><td>{{ ct.station_name or "—" }}</td></tr>
  <tr><th>Recording device</th><td>{{ ct.recording_device or "—" }}</td></tr>
  <tr><th>Record start</th><td>{{ ct.start_timestamp or "—" }}</td></tr>
  <tr><th>Sample rate</th><td>{% if ct.sample_rate_hz %}{{ ct.sample_rate_hz }} Hz{% else %}—{% endif %}</td></tr>
  <tr><th>Samples</th><td>{{ ct.total_samples if ct.total_samples is not none else "—" }}</td></tr>
  <tr><th>Analog / digital channels</th>
      <td>{{ ct.analog_channel_count if ct.analog_channel_count is not none else "—" }} / {{ ct.digital_channel_count if ct.digital_channel_count is not none else "—" }}</td></tr>
  <tr><th>Validation</th><td>{{ ct.validation_status or "—" }}</td></tr>
  <tr><th>Data quality</th><td>{{ ct.data_quality or dq.event_data_quality or "—" }}</td></tr>
  {% if ct.parse_warnings %}
  <tr><th>Parse warnings</th><td>{{ ct.parse_warnings }}</td></tr>
  {% endif %}
</table>
{% elif dq.event_data_quality and dq.event_data_quality != "NOT AVAILABLE" %}
<table class="kv">
  <tr><th>Data quality</th><td>{{ dq.event_data_quality }}</td></tr>
  <tr><th>COMTRADE detail</th><td>Record-level CFG metadata not loaded — open COMTRADE tab or re-run analysis.</td></tr>
</table>
{% elif dq.status %}
<p>{{ dq.status }}</p>
{% else %}
<p>NOT AVAILABLE — re-run analysis after COMTRADE parse.</p>
{% endif %}

{# ——— 4. Settings ——— #}
<h2>4. Setting Reference (bound for this analysis)</h2>
{% if settings.status %}
<p>{{ settings.status }}{% if settings.hint %} — {{ settings.hint }}{% endif %}</p>
{% else %}
<table class="kv">
  <tr><th>Source</th><td>{{ settings.setting_source_used or "—" }}</td></tr>
  <tr><th>Version</th><td>{{ settings.setting_version or "—" }}</td></tr>
  <tr><th>Setting group</th><td>{{ settings.setting_group or "—" }}</td></tr>
  <tr><th>Active group</th><td>{{ settings.active_setting_group_verification or "—" }}</td></tr>
  <tr><th>Approval</th><td>{{ settings.setting_approval or "—" }}</td></tr>
  <tr><th>Settings file</th><td>{{ settings.setting_file or "—" }}</td></tr>
  <tr><th>Parameters loaded</th><td>{{ settings.param_count if settings.param_count is not none else "—" }}</td></tr>
</table>
{% if settings.explanation %}<p class="meta">{{ settings.explanation }}</p>{% endif %}
{% endif %}

{# ——— 5. Sequence ——— #}
<h2>5. Sequence of Operation</h2>
{% if timing.pickup_to_trip_ms is defined and timing.pickup_to_trip_ms is not none or timing.trip_to_clear_ms is defined and timing.trip_to_clear_ms is not none %}
<p class="meta">
  {% if timing.pickup_to_trip_ms is defined and timing.pickup_to_trip_ms is not none %}
    Pickup → trip: <strong>{{ timing.pickup_to_trip_ms }} ms</strong>
  {% endif %}
  {% if timing.trip_to_clear_ms is defined and timing.trip_to_clear_ms is not none %}
    · Trip → current clear: <strong>{{ timing.trip_to_clear_ms }} ms</strong>
  {% endif %}
  · Breaker: <strong>{{ breaker.assessment or "—" }}</strong>
  {% if intertrip_summary and intertrip_summary != "None asserted" %}
    · Intertrip: <strong>{{ intertrip_summary }}</strong>
  {% endif %}
</p>
{% endif %}
{% set seq_rows = key_seq if key_seq else (analysis.timeline or []) %}
{% if key_seq %}
<p class="meta">Key operate sequence ({{ key_seq|length }} of {{ (analysis.timeline or [])|length }} timeline events).</p>
{% endif %}
<table>
  <tr><th>Step</th><th>Time (s)</th><th>Source</th><th>Confidence</th></tr>
  {% for e in seq_rows %}
  <tr>
    <td>{{ e.event_type_label or e.event_type }}{% if e.label %} <span class="meta">({{ e.label }})</span>{% endif %}{% if e.value and e.value != "—" %} <span class="meta">· {{ e.value }}</span>{% endif %}</td>
    <td>{{ "%.4f"|format(e.timestamp|float) if e.timestamp is not none else "—" }}</td>
    <td>{{ e.source or "—" }}</td>
    <td>{{ e.confidence or "—" }}</td>
  </tr>
  {% else %}
  <tr><td colspan="4">NOT AVAILABLE — re-run analysis to reconstruct the timeline from COMTRADE / SOE.</td></tr>
  {% endfor %}
</table>

{# ——— 6. Electrical ——— #}
<h2>6. Electrical Quantities</h2>
{% if elec.sample_rate_hz or elec.nominal_frequency_hz %}
<p class="meta">
  {% if elec.sample_rate_hz %}Sample rate: {{ elec.sample_rate_hz }} Hz{% endif %}
  {% if elec.nominal_frequency_hz %} · Nominal frequency: {{ elec.nominal_frequency_hz }} Hz{% endif %}
</p>
{% endif %}
{% if elec.rms %}
<table>
  <tr><th>Channel</th><th>RMS</th><th>Unit</th><th>Status</th></tr>
  {% for name, row in elec.rms.items() %}
  <tr>
    <td>{{ name }}</td>
    <td>{% if row.value is not none %}{{ "%.3f"|format(row.value|float) if row.value is number else row.value }}{% else %}—{% endif %}</td>
    <td>{{ row.unit or "" }}</td>
    <td>{{ row.status or "" }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p>RMS summary NOT AVAILABLE — open Waveforms / Electrical after analysis.</p>
{% endif %}

{# ——— 7. Fault ——— #}
<h2>7. Fault Classification &amp; Location</h2>
<table class="kv">
  <tr><th>DFR event class</th><td>{{ event_class | humanize_label }}</td></tr>
  <tr><th>Fault type</th><td>{{ fault.fault_type or "UNKNOWN" }}</td></tr>
  <tr><th>Classification status</th><td>{{ fault.status or "—" }}</td></tr>
  <tr><th>Confidence</th><td>{{ fault.confidence or "INCONCLUSIVE" }}</td></tr>
  {% if fault.involved_phases %}
  <tr><th>Phases</th><td>{% if fault.involved_phases is string %}{{ fault.involved_phases }}{% else %}{{ fault.involved_phases | join(", ") }}{% endif %}</td></tr>
  {% endif %}
  {% if fault.ground_involved is not none %}
  <tr><th>Ground</th><td>{{ "Yes" if fault.ground_involved else "No" }}</td></tr>
  {% endif %}
  <tr>
    <th>Fault location</th>
    <td>
      {% if fault.distance_display %}
        {{ fault.distance_display }}
      {% else %}
        Not applicable / not calculated for this scheme
      {% endif %}
    </td>
  </tr>
</table>
{% if fault.limitations %}
<p class="meta">Notes: {{ fault.limitations | join("; ") }}</p>
{% endif %}

{# ——— 8. Protection ——— #}
<h2>8. Protection Performance</h2>
<table>
  <tr>
    <th>Element</th>
    <th>Enabled</th>
    <th>Pickup</th>
    <th>Trip</th>
    <th>Expected</th>
    <th>Actual</th>
    <th>Consistency</th>
  </tr>
  {% for a in analysis.protection_assessment or [] %}
  <tr>
    <td><strong>{{ a.element | ansi_label }}</strong></td>
    <td>{{ a.enabled_display or a.enabled }}</td>
    <td>{{ a.pickup_display or a.pickup }}</td>
    <td>{{ a.trip_display or a.trip }}</td>
    <td>{{ a.expected_operation or "—" }}</td>
    <td>{{ a.actual_operation or "—" }}</td>
    <td>{{ a.consistency or "—" }}</td>
  </tr>
  {% else %}
  <tr><td colspan="7">NOT AVAILABLE — re-run analysis after settings and COMTRADE digitals are loaded.</td></tr>
  {% endfor %}
</table>

{# ——— 9. Consistency ——— #}
<h2>9. Protection Consistency Check</h2>
<table>
  <tr><th>Element</th><th>Check</th><th>Status</th><th>Severity</th><th>Explanation</th></tr>
  {% for f in analysis.consistency_findings or [] %}
  <tr>
    <td>{{ f.element | ansi_label }}</td>
    <td>{{ f.check_label or f.check_type }}</td>
    <td>{{ f.status }}</td>
    <td>{{ f.severity }}</td>
    <td>{{ f.explanation or "—" }}</td>
  </tr>
  {% else %}
  <tr><td colspan="5">NOT AVAILABLE</td></tr>
  {% endfor %}
</table>

{# ——— 10. RCA ——— #}
<h2>10. Root Cause Assessment</h2>
{% if primary %}
<div class="callout">
  <p><strong>Primary:</strong> {{ primary.title or primary.hypothesis_id }} —
    <span class="badge {% if primary.status == 'CONFIRMED' %}badge-ok{% elif primary.status in ['PROBABLE','POSSIBLE'] %}badge-warn{% else %}badge-bad{% endif %}">{{ primary.status }}</span>
    · score {{ primary.score or "—" }}
  </p>
  {% if primary.statement %}<p>{{ primary.statement }}</p>{% endif %}
  {% if primary.explanation %}<p class="meta">{{ primary.explanation }}</p>{% endif %}
  {% if primary.causal_chain %}
  <p><strong>Causal chain:</strong>
    {% for step in primary.causal_chain[:8] %}{{ step }}{% if not loop.last %} → {% endif %}{% endfor %}
  </p>
  {% endif %}
  {% if primary.supporting_evidence_labels %}
  <p><strong>Supporting evidence:</strong> {{ primary.supporting_evidence_labels | join("; ") }}</p>
  {% endif %}
  {% if primary.missing_evidence_labels %}
  <p><strong>Missing evidence:</strong> {{ primary.missing_evidence_labels | join("; ") }}</p>
  {% else %}
  <p class="meta">Missing evidence: none recorded</p>
  {% endif %}
</div>
{% else %}
<p>INCONCLUSIVE — no primary hypothesis ranked.</p>
{% endif %}

{# ——— 11. Actions ——— #}
<h2>11. Recommended Verification</h2>
<ul>
{% for a in decision.recommended_actions or primary.recommended_actions or [] %}
  <li>{{ a }}</li>
{% else %}
  <li>Verify active setting group against the event time</li>
  <li>Review Consistency and Protection tables</li>
  <li>Confirm channel mapping and DR targets</li>
{% endfor %}
</ul>

{# ——— 12. Limitations ——— #}
<h2>12. Limitations &amp; Confidence</h2>
<p>Overall confidence: <strong>{{ decision.confidence or "INCONCLUSIVE" }}</strong></p>
<div class="limitations">
  <ul>
  {% for lim in analysis.limitations or [] %}
    <li>{{ lim }}</li>
  {% else %}
    <li>None recorded</li>
  {% endfor %}
  </ul>
</div>

{# ——— 13. Review ——— #}
<h2>13. Engineer Review</h2>
{% set er = analysis.engineer_review %}
{% if er is mapping %}
  <p><strong>{{ er.action or "PENDING" }}</strong></p>
  {% if er.reviewed_at %}<p>Reviewed at: {{ er.reviewed_at }}</p>{% endif %}
  {% if er.decision_state %}<p>Decision state: {{ er.decision_state }}</p>{% endif %}
  {% if er.comments %}<p>Comments: {{ er.comments }}</p>{% endif %}
{% elif er %}
  <p style="white-space: pre-wrap; margin: 0;">{{ er }}</p>
{% else %}
  <p>PENDING — complete Review (ACCEPT / MODIFY / REJECT / …) after engineering check.</p>
{% endif %}

{# ——— 14. Files ——— #}
<h2>14. Evidence Files</h2>
{% if analysis.files %}
<table>
  <tr><th>Filename</th><th>Type</th><th>SHA-256 (prefix)</th></tr>
  {% for f in analysis.files %}
  <tr>
    <td>{{ f.filename }}</td>
    <td>{{ f.type }}</td>
    <td>{{ f.sha256 }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p>No file inventory available.</p>
{% endif %}

<div class="footnote">
  Report generated from structured analysis artefacts only. Conclusions distinguish OBSERVED /
  CALCULATED / INFERRED / HYPOTHESIS. This system does not invent measurements, settings, or root
  cause, and does not issue OT control commands.
</div>
</body>
</html>
