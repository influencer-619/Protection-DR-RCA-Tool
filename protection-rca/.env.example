# Application
APP_NAME=Protection RCA Platform
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional first-admin bootstrap (NO demo events/assets). Leave blank for empty DB.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# API
API_HOST=0.0.0.0
API_PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=protection_rca
POSTGRES_USER=protection
POSTGRES_PASSWORD=protection_dev_only
DATABASE_URL=postgresql+asyncpg://protection:protection_dev_only@postgres:5432/protection_rca

# Object Storage (MinIO / S3-compatible)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=protection-rca
S3_REGION=us-east-1
S3_USE_SSL=false

# Redis / Queue
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Upload limits
MAX_UPLOAD_SIZE_MB=200
ALLOWED_UPLOAD_EXTENSIONS=.cfg,.dat,.cff,.hdr,.inf,.csv,.txt,.xml,.json,.pdf,.zip
STORAGE_BACKEND=auto
LOCAL_STORAGE_PATH=storage
RATE_LIMIT_PER_MINUTE=120
RUN_ANALYSIS_SYNC=true

# Auth (local JWT for development; OIDC ready)
AUTH_MODE=local
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=

# Observability
LOG_LEVEL=INFO
ENABLE_METRICS=true

# Engineering
DEFAULT_NOMINAL_FREQUENCY=50.0
PHASOR_MAGNITUDE_TOLERANCE=0.02
PHASE_ANGLE_TOLERANCE_DEG=1.0
FREQUENCY_TOLERANCE_HZ=0.05
RMS_TOLERANCE=0.02
IMPEDANCE_TOLERANCE=0.05
TIMESTAMP_TOLERANCE_US=10
